        (isActiveStaff() && 'firstName' in staffDirData() && staffDirData().firstName.size() >= 3 && existing().counsellor == staffDirData().firstName) ||
        (isActiveStaff() && 'firstName' in staffDirData() && staffDirData().firstName.size() >= 3 && existing().mentor == staffDirData().firstName) ||
        (isActiveStaff() && 'firstName' in staffDirData() && staffDirData().firstName.size() >= 3 && existing().universityMentor == staffDirData().firstName) ||
        (isActiveStaff() && 'firstName' in staffDirData() && staffDirData().firstName.size() >= 3 && existing().researchMentor == staffDirData().firstName) ||
        (isActiveStaff() && 'firstName' in staffDirData() && staffDirData().firstName.size() >= 3 && existing().satMathMentor == staffDirData().firstName) ||
