    }

    match /launchpad_progress/{progressId} {
      allow get: if isPortalAuthenticated() && isValidId(progressId) && (hasGlobalStaffAccess() || isEmailAuthorizedInDoc(existing()));
      allow list: if hasGlobalStaffAccess() || (isPortalAuthenticated() && (
        authEmailLower() in existing().allowedViewerEmails ||
        existing().studentEmail == authEmailLower()
      ));
      allow create: if isPortalAuthenticated() && isValidId(progressId) && isValidLaunchpadProgress(incoming()) && incoming().id == progressId && (
        isAdmin() || isActiveStaff() || ('studentEmail' in incoming() && incoming().studentEmail == authEmailLower())
      );
      allow update: if isPortalAuthenticated() && isValidId(progressId) && isValidLaunchpadProgress(incoming()) && hasUnchangedOrInitializedDocId(progressId) && (
        isAdmin() ||
        isActiveStaff() ||
        ('studentEmail' in existing() && existing().studentEmail == authEmailLower() &&
          incoming().studentId == existing().studentId &&
          incoming().subjectId == existing().subjectId &&
          incoming().weekNumber == existing().weekNumber &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'lectureCompleted', 'readingCompleted', 'exerciseSubmissionJson',
            'exerciseCompleted', 'evaluationStatus', 'updatedAt'
          ]))
      );
      allow delete: if isAdmin() && isValidId(progressId);
    }

    match /launchpad_certifications/{certId} {
      allow get: if isPortalAuthenticated() && isValidId(certId) && (hasGlobalStaffAccess() || isEmailAuthorizedInDoc(existing()));
      allow list: if hasGlobalStaffAccess() || (isPortalAuthenticated() && (
        authEmailLower() in existing().allowedViewerEmails ||
        existing().studentEmail == authEmailLower()
      ));
      allow create, update: if isPortalAuthenticated() && isValidId(certId) && isValidLaunchpadCertification(incoming()) && incoming().id == certId && (
        isAdmin() || isActiveStaff() || ('studentEmail' in incoming() && incoming().studentEmail == authEmailLower())
      );
      allow delete: if isAdmin() && isValidId(certId);
    }

    match /assignment_evaluations/{evalId} {
      allow get: if isPortalAuthenticated() && isValidId(evalId) && (hasGlobalStaffAccess() || isEmailAuthorizedInDoc(existing()));
      allow list: if hasGlobalStaffAccess() || (isPortalAuthenticated() && (
        authEmailLower() in existing().allowedViewerEmails ||
        existing().studentEmail == authEmailLower()
      ));
      allow create: if isPortalAuthenticated() && isValidId(evalId) && isValidEvaluation(incoming()) && incoming().id == evalId && (
        isAdmin() || isActiveStaff() ||
        ('studentEmail' in incoming() && incoming().studentEmail == authEmailLower() && incoming().status == 'Submitted')
      );
      allow update: if isPortalAuthenticated() && isValidId(evalId) && isValidEvaluation(incoming()) && hasUnchangedOrInitializedDocId(evalId) && (
        isAdmin() ||
        isActiveStaff() ||
        ('studentEmail' in existing() && existing().studentEmail == authEmailLower() &&
          incoming().studentId == existing().studentId &&
          incoming().subjectId == existing().subjectId &&
          incoming().status == 'Submitted' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'submissionJson', 'status', 'submittedAt', 'chapterTitle', 'taskId'
          ]))
      );
      allow delete: if isAdmin() && isValidId(evalId);
    }

    match /notifications/{notifId} {
      allow get: if isPortalAuthenticated() && isValidId(notifId) && (isAdmin() || isEmailAuthorizedInDoc(existing()) || existing().recipientId == request.auth.uid);
      allow list: if isBootstrappedAdmin() || (isPortalAuthenticated() && (
        authEmailLower() in existing().allowedViewerEmails ||
        existing().recipientEmail == authEmailLower() ||
        existing().recipientId == request.auth.uid
      ));
      allow create: if isPortalAuthenticated() && isValidId(notifId) && isValidNotification(incoming()) && incoming().id == notifId && (
        isAdmin() || isActiveStaff() || (incoming().category == 'LAUNCHPAD' && incoming().recipientType == 'staff')
      );
      allow update: if isPortalAuthenticated() && isValidId(notifId) && isValidNotification(incoming()) && hasUnchangedOrInitializedDocId(notifId) && (
        isAdmin() || isActiveStaff() ||
        ((isEmailAuthorizedInDoc(existing()) || existing().recipientId == request.auth.uid) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['id', 'isRead']))
      );
      allow delete: if isAdmin() && isValidId(notifId);
    }
  }
}
