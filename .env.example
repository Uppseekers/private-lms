# FIREBASE_SERVICE_ACCOUNT_JSON: Optional Service Account JSON (or base64 JSON) for server-side Firebase Admin Auth user provisioning, password resets, and persistent Zoho OAuth token storage in Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# GEMINI_API_KEY: Required for Gemini AI API calls (Author's Compass & Launchpad chapter parser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The production URL where this portal is hosted (e.g. https://portal.uppseekers.com) used for OAuth callbacks like Zoho Meeting.
APP_URL="MY_APP_URL"

# ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET, ZOHO_ORG_ID, ZOHO_DC, ZOHO_SCOPES: Required for Zoho Account OAuth 2.0 (Zoho Meeting v2 / Zoho CRM / Zoho One).
ZOHO_CLIENT_ID="MY_ZOHO_CLIENT_ID"
ZOHO_CLIENT_SECRET="MY_ZOHO_CLIENT_SECRET"
ZOHO_ORG_ID=""
ZOHO_DC="com"
ZOHO_SCOPES="ZohoMeeting.manageOrg.READ,ZohoMeeting.meeting.CREATE,ZohoMeeting.meeting.UPDATE,ZohoMeeting.meeting.DELETE"

# PORT: Server listening port (default 3000)
PORT=3000

# Optional Legacy PostgreSQL / Cloud SQL configuration (not required when using Firebase Auth + Cloud Firestore)
# SQL_HOST=""
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_DB_NAME=""
