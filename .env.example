# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for OAuth callbacks like Zoho Meeting).
APP_URL="MY_APP_URL"

# ZOHO_CLIENT_ID & ZOHO_CLIENT_SECRET: Required for Multi-DC Zoho Meeting OAuth 2.0 integration.
ZOHO_CLIENT_ID="MY_ZOHO_CLIENT_ID"
ZOHO_CLIENT_SECRET="MY_ZOHO_CLIENT_SECRET"

# DATABASE_URL: Required for Cloud SQL / PostgreSQL database persistence on Vercel or Hostinger.
# Example: postgresql://postgres:password@localhost:5432/uppseekers_db
DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# PORT: Server listening port (default 3000)
PORT=3000
